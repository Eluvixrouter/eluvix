+        companyId: "comp-1",
+        name: "Hermes OpenRouter",
+        adapterType: "hermes_local",
+        adapterConfig: {},
+      },
+      runtime: { sessionId: null, sessionParams: null, sessionDisplayId: null, taskKey: null },
+      config: {
+        hermesCommand: command,
+        model: "anthropic/claude-sonnet-4",
+        provider: "openrouter",
+        env: {
+          HERMES_HOME: hermesHome,
+          CAPTURE_PATH: capturePath,
+        },
+      },
+      context: { taskId: "issue-hermes-2" },
+      onLog: async () => {},
+    });
+
+    const captured = JSON.parse(await fs.readFile(capturePath, "utf8")) as { home: string; configYaml: string | null };
+    expect(captured.home).toBe(hermesHome);
+    expect(captured.configYaml).toBeNull();
+    expect(result.biller).toBeUndefined();
+  });
+});
