+    capturePath = path.join(rootDir, "capture.json");
+    command = path.join(rootDir, "hermes.cjs");
+    await fs.writeFile(
+      command,
+      `#!${process.execPath}
+const fs = require("node:fs");
+const path = require("node:path");
+const home = process.env.HERMES_HOME;
+const configYaml = fs.existsSync(path.join(home, "config.yaml"))
+  ? fs.readFileSync(path.join(home, "config.yaml"), "utf8")
+  : null;
+const hasSkillsSymlink = fs.existsSync(path.join(home, "skills", "custom.md"));
+fs.writeFileSync(process.env.CAPTURE_PATH, JSON.stringify({ home, configYaml, hasSkillsSymlink }));
