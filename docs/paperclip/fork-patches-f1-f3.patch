@@ -0,0 +1,142 @@
+import { createHmac } from "node:crypto";
+import { describe, expect, it } from "vitest";
+import {
+  inferOpenAiCompatibleBiller,
+  isEluvixTarget,
+  isReportedCostSourceEnabled,
+  resolveManagedOpenAiBilling,
+} from "./billing.js";
+import {
+  buildPaperclipRoutingHeaders,
+  canonicalPaperclipSignaturePayload,
+  mergePaperclipHeadersIntoCustomHeadersText,
+  shouldInjectPaperclipRoutingHeaders,
+  signPaperclipRoutingHeaders,
+} from "./eluvix-headers.js";
+
+describe("Eluvix opt-in billing & cost-source attribution (F1)", () => {
+  it("does not misclassify generic localhost, OpenRouter, or custom gateways as Eluvix", () => {
+    expect(isEluvixTarget({ baseUrl: "http://127.0.0.1:3588/v1" })).toBe(false);
+    expect(isEluvixTarget({ baseUrl: "https://openrouter.ai/api/v1", env: { OPENROUTER_API_KEY: "sk-or-v1-test" } })).toBe(false);
+    expect(isEluvixTarget({ routing: { kind: "custom", baseUrl: "http://gateway.example/v1" } })).toBe(false);
+    expect(resolveManagedOpenAiBilling({ kind: "custom", baseUrl: "http://127.0.0.1:8080/v1" })).toEqual({
+      provider: "openai",
+      biller: "unknown",
+      billingType: "api",
+    });
+    expect(isReportedCostSourceEnabled({ biller: "openrouter", env: {} })).toBe(false);
+  });
+
+  it("activates Eluvix billing & reported cost-source only on explicit signals", () => {
+    expect(isEluvixTarget({ routing: { kind: "custom", baseUrl: "http://127.0.0.1:3588/v1", costSource: "eluvix" } })).toBe(true);
+    expect(isEluvixTarget({ env: { OPENAI_API_KEY: "elx_abcdefghijklmnopqrstuvwxyz" } })).toBe(true);
+    expect(isEluvixTarget({ baseUrl: "http://router.local:4000/v1", env: { ELUVIX_BASE_URL: "http://router.local:4000" } })).toBe(true);
+    expect(isEluvixTarget({ baseUrl: "https://eluvix.internal/v1" })).toBe(false);
+    expect(isEluvixTarget({ baseUrl: "https://router.eluvix/v1" })).toBe(true);
+
+    expect(
+      resolveManagedOpenAiBilling({ kind: "custom", baseUrl: "http://127.0.0.1:3588/v1", costSource: "eluvix" }),
+    ).toEqual({
+      provider: "openai",
+      biller: "eluvix",
+      billingType: "api",
+    });
+    expect(
+      inferOpenAiCompatibleBiller({ OPENAI_API_KEY: "elx_abcdefghijklmnopqrstuvwxyz", OPENAI_BASE_URL: "http://127.0.0.1:3588/v1" }),
+    ).toBe("eluvix");
+    expect(isReportedCostSourceEnabled({ biller: "eluvix" })).toBe(true);
+    expect(isReportedCostSourceEnabled({ routing: { costSource: "provider_reported" } })).toBe(true);
+    expect(isReportedCostSourceEnabled({ env: { PAPERCLIP_COST_SOURCE: "eluvix" } })).toBe(true);
+  });
+});
+
+describe("Execute-time Paperclip routing headers & HMAC signing (F2/F3)", () => {
+  it("gates injection away from direct vendor endpoints unless explicitly requested", () => {
+    expect(shouldInjectPaperclipRoutingHeaders({ baseUrl: "https://api.openai.com/v1", env: { ELUVIX_API_KEY: "elx_test" } })).toBe(false);
+    expect(shouldInjectPaperclipRoutingHeaders({ baseUrl: "http://127.0.0.1:3588/v1", env: { ELUVIX_API_KEY: "elx_test" } })).toBe(true);
+    expect(shouldInjectPaperclipRoutingHeaders({ baseUrl: "https://api.openai.com/v1", env: { PAPERCLIP_AI_BILLER: "eluvix" } })).toBe(true);
+    expect(shouldInjectPaperclipRoutingHeaders({ baseUrl: "https://api.openai.com/v1", env: { PAPERCLIP_ELUVIX_HMAC_SECRET: "secret" } })).toBe(false);
+    expect(shouldInjectPaperclipRoutingHeaders({ baseUrl: "https://gateway.example/v1", env: {} })).toBe(false);
+    expect(
+      shouldInjectPaperclipRoutingHeaders({
+        baseUrl: "http://127.0.0.1:3588/v1",
+        env: { PAPERCLIP_ELUVIX_HMAC_SECRET: "secret" },
+      }),
+    ).toBe(true);
+    expect(
+      shouldInjectPaperclipRoutingHeaders({
+        baseUrl: "https://gateway.example/v1",
+        config: { eluvixRouting: true },
+      }),
+    ).toBe(true);
+  });
+
+  it("extracts live context headers and signs canonical v1 HMAC-SHA256 signatures", () => {
+    const headers = buildPaperclipRoutingHeaders({
+      runId: "run-42",
+      agent: {
+        id: "agent-7",
+        companyId: "comp-1",
+        budgetMonthlyCents: 10000,
+        spentMonthlyCents: 8500,
+      },
+      context: {
+        taskId: "issue-99",
+        paperclipRoutingContext: {
+          priority: "critical",
+          sensitivity: "confidential",
+          hop: 2,
+        },
+      },
+      hmacSecret: "top-secret-hmac",
+      timestamp: "1763000000000",
+    });
+
+    expect(headers["x-paperclip-run-id"]).toBe("run-42");
+    expect(headers["x-paperclip-issue-id"]).toBe("issue-99");
+    expect(headers["x-paperclip-agent-id"]).toBe("agent-7");
+    expect(headers["x-paperclip-company-id"]).toBe("comp-1");
+    expect(headers["x-paperclip-issue-priority"]).toBe("critical");
+    expect(headers["x-paperclip-budget-remaining-pct"]).toBe("15");
+    expect(headers["x-paperclip-sensitivity"]).toBe("confidential");
+    expect(headers["x-paperclip-hop"]).toBe("2");
+    expect(headers["x-paperclip-context-ts"]).toBe("1763000000000");
+
+    const expectedPayload = canonicalPaperclipSignaturePayload({
+      ts: "1763000000000",
+      runId: "run-42",
+      issueId: "issue-99",
+      agentId: "agent-7",
+      companyId: "comp-1",
+      priority: "critical",
+      budgetRemainingPct: "15",
+      sensitivity: "confidential",
+      hop: "2",
+    });
+    expect(expectedPayload).toBe(
+      "v1|1763000000000|run-42|issue-99|agent-7|comp-1|critical|15|confidential|2",
+    );
+    const expectedMac = createHmac("sha256", "top-secret-hmac").update(expectedPayload, "utf8").digest("hex");
+    expect(headers["x-paperclip-context-sig"]).toBe(`v1.1763000000000.${expectedMac}`);
+  });
+
+  it("merges signed headers into ANTHROPIC_CUSTOM_HEADERS without clobbering X-Anthropic-Agent-Id", () => {
+    const signed = signPaperclipRoutingHeaders(
+      {
+        "x-paperclip-run-id": "run-2",
+        "x-paperclip-issue-priority": "high",
+        "x-paperclip-hop": "1",
+      },
+      "secret-key",
+      "1763000100000",
+    );
+    const merged = mergePaperclipHeadersIntoCustomHeadersText(
+      "X-Anthropic-Agent-Id: agent-123\nX-Paperclip-Run-Id: stale-run",
+      signed,
+    );
+    expect(merged).toContain("X-Anthropic-Agent-Id: agent-123");
+    expect(merged).toContain("x-paperclip-run-id: run-2");
+    expect(merged).not.toContain("stale-run");
+    expect(merged).toContain("x-paperclip-context-sig: v1.1763000100000.");
+  });
+});
diff --git i/packages/adapter-utils/src/eluvix-headers.ts w/packages/adapter-utils/src/eluvix-headers.ts
new file mode 100644
index 00000000..0b9ce5cd
--- /dev/null
+++ w/packages/adapter-utils/src/eluvix-headers.ts
@@ -0,0 +1,315 @@
+import { createHmac } from "node:crypto";
+import { isEluvixTarget } from "./billing.js";
+
+const PRIORITIES = new Set(["critical", "high", "medium", "low"]);
+
+export interface PaperclipRoutingHeaderFields {
+  runId?: string | null;
+  issueId?: string | null;
+  agentId?: string | null;
+  companyId?: string | null;
+  priority?: string | null;
+  budgetRemainingPct?: number | string | null;
+  sensitivity?: string | null;
+  hop?: number | string | null;
+}
+
+export function sanitizePaperclipHeaderValue(value: unknown, maxLen = 256): string | null {
+  if (typeof value === "number") {
+    if (!Number.isFinite(value)) return null;
+    value = String(value);
+  }
+  if (typeof value !== "string") return null;
+  const cleaned = value.replace(/[\r\n\0]/g, "").trim();
+  if (!cleaned) return null;
+  return cleaned.slice(0, maxLen);
+}
+
+export function resolvePaperclipHmacSecret(
+  env?: Record<string, string | undefined>,
+  explicitSecret?: string | null,
+): string | null {
+  const candidates = [
+    explicitSecret,
+    env?.PAPERCLIP_ELUVIX_HMAC_SECRET,
+    env?.ELUVIX_PAPERCLIP_HMAC_SECRET,
+    process.env.PAPERCLIP_ELUVIX_HMAC_SECRET,
+    process.env.ELUVIX_PAPERCLIP_HMAC_SECRET,
+  ];
+  for (const candidate of candidates) {
+    if (typeof candidate === "string" && candidate.trim().length > 0) {
+      return candidate.trim();
+    }
+  }
+  return null;
+}
+
+export function canonicalPaperclipSignaturePayload(fields: {
+  ts: string;
+  runId?: string | null;
+  issueId?: string | null;
+  agentId?: string | null;
+  companyId?: string | null;
+  priority?: string | null;
+  budgetRemainingPct?: string | null;
+  sensitivity?: string | null;
+  hop?: string | null;
+}): string {
+  return [
+    "v1",
+    fields.ts,
+    fields.runId ?? "",
+    fields.issueId ?? "",
+    fields.agentId ?? "",
+    fields.companyId ?? "",
+    fields.priority ?? "",
+    fields.budgetRemainingPct ?? "",
+    fields.sensitivity ?? "",
+    fields.hop ?? "0",
+  ].join("|");
+}
+
+export function signPaperclipRoutingHeaders(
+  headers: Record<string, string>,
+  secret: string,
+  ts: string = String(Date.now()),
+): Record<string, string> {
+  const payload = canonicalPaperclipSignaturePayload({
+    ts,
+    runId: headers["x-paperclip-run-id"],
+    issueId: headers["x-paperclip-issue-id"],
+    agentId: headers["x-paperclip-agent-id"],
+    companyId: headers["x-paperclip-company-id"],
+    priority: headers["x-paperclip-issue-priority"],
+    budgetRemainingPct: headers["x-paperclip-budget-remaining-pct"],
+    sensitivity: headers["x-paperclip-sensitivity"],
+    hop: headers["x-paperclip-hop"] ?? "0",
+  });
+  const mac = createHmac("sha256", secret).update(payload, "utf8").digest("hex");
+  return {
+    ...headers,
+    "x-paperclip-context-ts": ts,
+    "x-paperclip-context-sig": `v1.${ts}.${mac}`,
+  };
+}
+
+export function shouldInjectPaperclipRoutingHeaders(input: {
+  baseUrl?: string | null;
+  env?: Record<string, string | undefined>;
+  config?: Record<string, unknown>;
+  routing?: unknown;
+}): boolean {
+  const cfg = input.config ?? {};
+  const env = input.env ?? {};
+  if (cfg.eluvixRouting === false || env.PAPERCLIP_ELUVIX_INJECT_HEADERS === "0") {
+    return false;
+  }
+  if (
+    cfg.eluvixRouting === true ||
+    cfg.injectPaperclipHeaders === true ||
+    env.PAPERCLIP_ELUVIX_INJECT_HEADERS === "1"
+  ) {
+    return true;
+  }
+  const routing = input.routing ?? cfg.managedAiRouting;
+  const routingCostSource =
+    routing && typeof routing === "object" ? (routing as { costSource?: unknown }).costSource : undefined;
+  const explicitBillerEluvix =
+    (env.PAPERCLIP_AI_BILLER ?? env.ELUVIX_BILLER)?.trim().toLowerCase() === "eluvix";
+  if (input.baseUrl && routingCostSource !== "eluvix" && !explicitBillerEluvix) {
+    try {
+      const host = new URL(input.baseUrl).hostname.toLowerCase();
+      if (host === "api.openai.com" || host === "api.anthropic.com" || host === "openrouter.ai") {
+        return false;
+      }
+    } catch {
+      // ignore invalid URL
+    }
+  }
+  if (isEluvixTarget({ baseUrl: input.baseUrl, env, routing })) {
+    return true;
+  }
+  // If an HMAC secret is explicitly configured alongside a non-vendor gateway
+  // or local URL, sign and attach routing headers for that gateway.
+  const secret = resolvePaperclipHmacSecret(env);
+  if (secret && input.baseUrl) {
+    return true;
+  }
+  return false;
+}
+
+function asObj(value: unknown): Record<string, unknown> | undefined {
+  return value && typeof value === "object" && !Array.isArray(value)
+    ? (value as Record<string, unknown>)
+    : undefined;
+}
+
+export function extractPaperclipRoutingContextFromAdapterContext(input: {
+  runId?: string | null;
+  agent?: {
+    id?: string | null;
+    companyId?: string | null;
+    budgetMonthlyCents?: number | null;
+    spentMonthlyCents?: number | null;
+  } | null;
+  context?: Record<string, unknown> | null;
+  config?: Record<string, unknown> | null;
+  env?: Record<string, string | undefined>;
+}): PaperclipRoutingHeaderFields {
+  const ctx = input.context ?? {};
+  const env = input.env ?? {};
+  const routingMeta = asObj(ctx.paperclipRoutingContext);
+  const issueObj = asObj(ctx.paperclipIssue);
+  const wakeObj = asObj(ctx.paperclipWake);
+  const wakeIssueObj = asObj(wakeObj?.issue);
+
+  const runId =
+    sanitizePaperclipHeaderValue(routingMeta?.runId) ??
+    sanitizePaperclipHeaderValue(input.runId) ??
+    sanitizePaperclipHeaderValue(env.PAPERCLIP_RUN_ID);
+  const companyId =
+    sanitizePaperclipHeaderValue(routingMeta?.companyId) ??
+    sanitizePaperclipHeaderValue(input.agent?.companyId) ??
+    sanitizePaperclipHeaderValue(env.PAPERCLIP_COMPANY_ID);
+  const agentId =
+    sanitizePaperclipHeaderValue(routingMeta?.agentId) ??
+    sanitizePaperclipHeaderValue(input.agent?.id) ??
+    sanitizePaperclipHeaderValue(env.PAPERCLIP_AGENT_ID);
+  const issueId =
+    sanitizePaperclipHeaderValue(routingMeta?.issueId) ??
+    sanitizePaperclipHeaderValue(ctx.taskId) ??
+    sanitizePaperclipHeaderValue(ctx.issueId) ??
+    sanitizePaperclipHeaderValue(issueObj?.id) ??
+    sanitizePaperclipHeaderValue(wakeIssueObj?.id) ??
+    sanitizePaperclipHeaderValue(env.PAPERCLIP_TASK_ID);
+
+  const rawPriority =
+    sanitizePaperclipHeaderValue(routingMeta?.priority) ??
+    sanitizePaperclipHeaderValue(ctx.issuePriority) ??
+    sanitizePaperclipHeaderValue(ctx.taskPriority) ??
+    sanitizePaperclipHeaderValue(issueObj?.priority) ??
+    sanitizePaperclipHeaderValue(wakeIssueObj?.priority) ??
+    sanitizePaperclipHeaderValue(env.PAPERCLIP_TASK_PRIORITY) ??
+    sanitizePaperclipHeaderValue(env.PAPERCLIP_ISSUE_PRIORITY);
+  const priority = rawPriority && PRIORITIES.has(rawPriority.toLowerCase())
+    ? rawPriority.toLowerCase()
+    : rawPriority;
+
+  let budgetRemainingPct: number | string | null =
+    (typeof routingMeta?.budgetRemainingPct === "number" || typeof routingMeta?.budgetRemainingPct === "string"
+      ? routingMeta.budgetRemainingPct
+      : null) ??
+    (typeof ctx.paperclipBudgetRemainingPct === "number" || typeof ctx.paperclipBudgetRemainingPct === "string"
+      ? ctx.paperclipBudgetRemainingPct
+      : null) ??
+    sanitizePaperclipHeaderValue(env.PAPERCLIP_BUDGET_REMAINING_PCT);
+
+  if (budgetRemainingPct === null && typeof input.agent?.budgetMonthlyCents === "number" && input.agent.budgetMonthlyCents > 0) {
+    const spent = typeof input.agent.spentMonthlyCents === "number" && Number.isFinite(input.agent.spentMonthlyCents)
+      ? Math.max(0, input.agent.spentMonthlyCents)
+      : 0;
+    const remaining = Math.max(0, Math.min(100, Math.round(((input.agent.budgetMonthlyCents - spent) / input.agent.budgetMonthlyCents) * 100)));
+    budgetRemainingPct = remaining;
+  }
+
+  const sensitivity =
+    sanitizePaperclipHeaderValue(routingMeta?.sensitivity) ??
+    sanitizePaperclipHeaderValue(ctx.paperclipSensitivity) ??
+    sanitizePaperclipHeaderValue(ctx.sensitivity) ??
+    sanitizePaperclipHeaderValue(issueObj?.sensitivity) ??
+    sanitizePaperclipHeaderValue(env.PAPERCLIP_TASK_SENSITIVITY) ??
+    sanitizePaperclipHeaderValue(env.PAPERCLIP_SENSITIVITY);
+
+  const rawHop =
+    routingMeta?.hop ??
+    ctx.paperclipHop ??
+    ctx.hop ??
+    env.PAPERCLIP_HOP ??
+    env.X_PAPERCLIP_HOP ??
+    0;
+  const parsedHop = typeof rawHop === "number" ? rawHop : Number(rawHop);
+  const hop = Number.isFinite(parsedHop) && parsedHop >= 0 ? Math.trunc(parsedHop) : 0;
+
+  return {
+    runId,
+    issueId,
+    agentId,
+    companyId,
+    priority,
+    budgetRemainingPct,
+    sensitivity,
+    hop,
+  };
+}
+
+export function buildPaperclipRoutingHeaders(input: {
+  runId?: string | null;
+  agent?: {
+    id?: string | null;
+    companyId?: string | null;
+    budgetMonthlyCents?: number | null;
+    spentMonthlyCents?: number | null;
+  } | null;
+  context?: Record<string, unknown> | null;
+  config?: Record<string, unknown> | null;
+  env?: Record<string, string | undefined>;
+  hmacSecret?: string | null;
+  timestamp?: string;
+}): Record<string, string> {
+  const fields = extractPaperclipRoutingContextFromAdapterContext(input);
+  const headers: Record<string, string> = {
+    "x-paperclip-hop": String(fields.hop ?? 0),
+  };
+  const companyId = sanitizePaperclipHeaderValue(fields.companyId);
+  const agentId = sanitizePaperclipHeaderValue(fields.agentId);
+  const runId = sanitizePaperclipHeaderValue(fields.runId);
+  const issueId = sanitizePaperclipHeaderValue(fields.issueId);
+  const priority = sanitizePaperclipHeaderValue(fields.priority);
+  const sensitivity = sanitizePaperclipHeaderValue(fields.sensitivity);
+
+  if (companyId) headers["x-paperclip-company-id"] = companyId;
+  if (agentId) headers["x-paperclip-agent-id"] = agentId;
+  if (runId) headers["x-paperclip-run-id"] = runId;
+  if (issueId) headers["x-paperclip-issue-id"] = issueId;
+  if (priority) headers["x-paperclip-issue-priority"] = priority;
+  if (sensitivity) headers["x-paperclip-sensitivity"] = sensitivity;
+
+  if (fields.budgetRemainingPct !== null && fields.budgetRemainingPct !== undefined && fields.budgetRemainingPct !== "") {
+    const pctNum = Number(fields.budgetRemainingPct);
+    if (Number.isFinite(pctNum)) {
+      headers["x-paperclip-budget-remaining-pct"] = String(Math.max(0, Math.min(100, Math.round(pctNum))));
+    }
+  }
+
+  const secret = resolvePaperclipHmacSecret(input.env, input.hmacSecret);
+  if (secret) {
+    return signPaperclipRoutingHeaders(headers, secret, input.timestamp);
+  }
+  return headers;
+}
+
+export function mergePaperclipHeadersIntoCustomHeadersText(
+  existing: string | undefined,
+  headers: Record<string, string>,
+): string {
+  const map = new Map<string, { name: string; value: string }>();
+  if (typeof existing === "string" && existing.trim().length > 0) {
+    for (const line of existing.split(/\r?\n/)) {
+      const colon = line.indexOf(":");
+      if (colon <= 0) continue;
+      const name = line.slice(0, colon).trim();
+      const value = sanitizePaperclipHeaderValue(line.slice(colon + 1));
+      if (!name || value === null) continue;
+      map.set(name.toLowerCase(), { name, value });
+    }
+  }
+  for (const [key, rawValue] of Object.entries(headers)) {
+    const cleanKey = sanitizePaperclipHeaderValue(key, 128);
+    const cleanVal = sanitizePaperclipHeaderValue(rawValue, 512);
+    if (!cleanKey || cleanVal === null) continue;
+    map.set(cleanKey.toLowerCase(), { name: cleanKey, value: cleanVal });
+  }
+  return Array.from(map.values())
+    .map(({ name, value }) => `${name}: ${value}`)
+    .join("\n");
+}
