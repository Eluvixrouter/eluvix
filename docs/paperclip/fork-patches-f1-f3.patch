+function unquoteYamlScalar(raw: string): string {
+  const withoutComment = raw.replace(/\s+#.*$/, "").trim();
+  if (
+    (withoutComment.startsWith('"') && withoutComment.endsWith('"')) ||
+    (withoutComment.startsWith("'") && withoutComment.endsWith("'"))
+  ) {
+    return withoutComment.slice(1, -1);
+  }
