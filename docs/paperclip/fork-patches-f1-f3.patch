+    const originalYaml = [
+      "model:",
+      "  default: eluvix/auto",
+      "  provider: custom",
+      "  base_url: http://127.0.0.1:3588/v1",
+      "  api_key: elx_abcdefghijklmnopqrstuvwxyz",
+      "",
+    ].join("\n");
+    await fs.writeFile(path.join(hermesHome, "config.yaml"), originalYaml, "utf8");
+
+    const result = await execute({
+      runId: "run-hermes-1",
+      agent: {
+        id: "agent-hermes-1",
+        companyId: "comp-1",
+        name: "Hermes Bot",
+        adapterType: "hermes_local",
+        adapterConfig: {},
+        budgetMonthlyCents: 1000,
+        spentMonthlyCents: 200,
+      } as any,
+      runtime: { sessionId: null, sessionParams: null, sessionDisplayId: null, taskKey: null },
+      config: {
+        hermesCommand: command,
+        model: "eluvix/auto",
+        provider: "custom",
+        env: {
+          HERMES_HOME: hermesHome,
+          CAPTURE_PATH: capturePath,
+          PAPERCLIP_ELUVIX_HMAC_SECRET: "hermes-secret",
+        },
+      },
+      context: {
+        taskId: "issue-hermes-1",
+        paperclipRoutingContext: {
+          priority: "high",
+          sensitivity: "internal",
+          hop: 1,
+        },
+      },
+      onLog: async () => {},
+    });
+
+    const captured = JSON.parse(await fs.readFile(capturePath, "utf8")) as {
+      home: string;
+      configYaml: string;
+      hasSkillsSymlink: boolean;
+    };
+    expect(result.biller).toBe("eluvix");
+    expect(captured.home).not.toBe(hermesHome);
+    expect(captured.hasSkillsSymlink).toBe(true);
+    expect(captured.configYaml).toContain('"x-paperclip-run-id":"run-hermes-1"');
+    expect(captured.configYaml).toContain('"x-paperclip-budget-remaining-pct":"80"');
+    expect(captured.configYaml).toContain('"x-paperclip-context-sig":"v1.');
+    // Original user config.yaml remains untouched, and temp overlay is deleted.
+    expect(await fs.readFile(path.join(hermesHome, "config.yaml"), "utf8")).toBe(originalYaml);
+    await expect(fs.access(captured.home)).rejects.toThrow();
