+/** Inject execute-time Paperclip/Eluvix routing headers into targeted providers. */
+function injectEluvixOpenCodeHeaders(
+  providers: Record<string, unknown>,
+  extraHeaders: Record<string, string> | undefined,
+  env: Record<string, string>,
+  config: Record<string, unknown>,
+): Record<string, unknown> {
+  if (!extraHeaders || Object.keys(extraHeaders).length === 0) return providers;
+  const mergedEnv = { ...process.env, ...env };
+  const result: Record<string, unknown> = { ...providers };
+  for (const [name, value] of Object.entries(result)) {
+    if (!isPlainObject(value)) continue;
+    const options = isPlainObject(value.options) ? value.options : {};
+    const baseUrl =
+      typeof options.baseURL === "string"
+        ? options.baseURL
+        : name === "paperclip" || name === "eluvix"
+          ? env.PAPERCLIP_AI_PROVIDER_URL ?? env.OPENAI_BASE_URL ?? process.env.OPENAI_BASE_URL
+          : undefined;
+    const providerApiKey = typeof options.apiKey === "string" ? options.apiKey.trim() : undefined;
+    const providerEnv = providerApiKey?.startsWith("elx_")
+      ? { ...mergedEnv, ELUVIX_API_KEY: providerApiKey }
+      : mergedEnv;
