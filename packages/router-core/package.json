{
  "name": "@eluvix/router-core",
  "version": "1.0.14",
  "description": "Core routing logic for Eluvix",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./clos-fabric": {
      "types": "./dist/clos-fabric-routing.d.ts",
