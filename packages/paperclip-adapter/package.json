{
  "name": "@eluvix/paperclip-adapter",
  "version": "1.3.0",
  "description": "Paperclip external adapter (eluvix_local) running the Eluvix OpenCode harness with Switchyard routing, mid-loop DLP, and reported cost attribution.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    },
    "./ui-parser": "./ui-parser.cjs"
  },
  "paperclip": {
    "adapterUiParser": "1.0.0"
  },
  "files": [
    "dist",
    "skills",
    "ui-parser.cjs"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "@paperclipai/adapter-utils": ">=0.3.1"
  },
  "peerDependenciesMeta": {
    "@paperclipai/adapter-utils": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.1.9"
  }
}
