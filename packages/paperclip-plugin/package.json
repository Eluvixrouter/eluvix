{
  "name": "@eluvix/paperclip-plugin",
  "version": "1.3.0",
  "description": "Paperclip plugin (eluvix.switchyard) exposing Eluvix Switchyard capabilities, ranked assignee recommendation, opt-in auto-assignment, and outcome feedback.",
  "license": "MIT",
  "type": "module",
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/index.js",
    "ui": "./dist/ui/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    }
  },
  "scripts": {
    "build": "tsc && node ./scripts/build-ui.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "@paperclipai/plugin-sdk": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@paperclipai/plugin-sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "18.3.31",
    "esbuild": "0.28.2",
    "react": "18.3.1",
    "typescript": "^5.0.0",
    "vitest": "^2.1.9"
  }
}
