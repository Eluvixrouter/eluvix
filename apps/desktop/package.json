{
  "name": "@eluvix/desktop",
  "version": "1.0.21",
  "type": "module",
  "description": "Eluvix Desktop - Local token router and OpenAI-compatible proxy with Billama integration",
  "homepage": "https://github.com/Eluvixrouter/eluvix",
  "author": "Eluvix Team",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc && pnpm run copy-assets",
    "copy-assets": "node scripts/copy-assets.mjs",
    "start": "electron .",
    "pack": "pnpm run build && electron-builder --dir --publish never",
    "dist": "pnpm run build && electron-builder --publish never",
    "dist:linux": "pnpm run build && electron-builder --linux --publish never",
    "dist:mac": "pnpm run build && electron-builder --mac --publish never",
    "dist:win": "pnpm run build && electron-builder --win --publish never"
  },
  "dependencies": {
    "@eluvix/router-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2"
  }
}
