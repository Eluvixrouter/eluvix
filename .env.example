# Eluvix environment template (hunt-2 M15).
#
# Usage: `cp .env.example .env`, then uncomment and set the values you need.
# This file lists exactly the variables the quickstart and the compose
# files consume — nothing else. Values shown here are placeholders, not
# real credentials; never commit a real `.env` (it is gitignored).
#
# How each group is consumed:
# - Docker Compose reads a repo-root `.env` automatically and substitutes
#   the ${...} references in docker-compose.yml, docker-compose.prod.yml,
#   and docker/compose/*.yml.
# - The local Next.js server (apps/nextjs/server.mjs) reads these from the
#   process environment; it does not auto-load a `.env` file, so export
#   them when running outside Compose.
# - If ADMIN_PASSWORD / NEXTAUTH_SECRET are left unset, the server
#   generates them into ~/.config/eluvix/auth.json on first boot
#   (apps/nextjs/server.mjs, packages/router-core/src/auth.ts).

# --- Credentials (compose + server). Leave commented to auto-generate. ---
# ADMIN_PASSWORD=replace-with-a-strong-password
# NEXTAUTH_SECRET=replace-with-a-long-random-secret

# Canonical URL for NextAuth callbacks. The prod compose default is shown;
# the server auto-detects host and port when this is unset.
NEXTAUTH_URL=http://localhost:3588

# --- Compose service port overrides (defaults shown; all optional). ---
# SWITCHYARD_PORT=8080
# VLLM_SR_PORT=8001
# VLLM_PORT=8000
# AGENT_ROUTER_PORT=8002
# AGENT_GATEWAY_PORT=8003
# OPENVIKING_PORT=1933
# LIGHTRAG_PORT=9621
# GRAPHITI_PORT=8004
# TRUEFORGE_PORT=8790
# OPENCODE_PORT=4096
# SANDBOX_PORT=3986
# OLLAMA_PORT=11434
# SGLANG_PORT=30000

# --- Next.js server process environment (defaults shown; all optional). ---
# PORT=3588
# HTTP_PORT=3580
# HOSTNAME=127.0.0.1
